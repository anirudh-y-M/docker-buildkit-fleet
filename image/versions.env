# Pins for the rebuilt BuildKit image. The CI workflow passes every line as a
# --build-arg; Renovate/Dependabot can bump them individually.
#
# Upstream components, at their upstream release tags.
BUILDKIT_VERSION=v0.33.0
RUNC_VERSION=v1.5.1
ROOTLESSKIT_VERSION=v3.1.0
CNI_VERSION=v1.9.1

# Toolchain and base. Bump GO_VERSION to the newest patch release whenever the
# Go standard library gets a security fix — that alone clears most findings.
GO_VERSION=1.26.8
ALPINE_VERSION=3.23
XX_VERSION=1.9.0

# Go modules raised above what the upstream projects pin, because published
# CVEs against them are fixed in these versions. Applied to every component
# that depends on them before compiling.
XCRYPTO_VERSION=v0.57.0
XNET_VERSION=v0.59.0
GOARCHIVE_VERSION=v0.3.3
